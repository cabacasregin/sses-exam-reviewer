# Copy this file to .env and fill in the values from your Firebase project:
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The code a would-be teacher must enter on the "Sign Up" tab of the Teacher
# Portal to create a teacher account. Change this to something private only
# your school's staff know.
EXPO_PUBLIC_TEACHER_INVITE_CODE=REVIEWBUDDY-TEACHER

# Set to "true" only when running against the local Firebase Emulator Suite
# (firebase emulators:start). Never set this in production.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
